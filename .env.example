# Local Compose only; production must supply independent credentials and identity.
AGENT_PLATFORM_DATABASE_URL=postgresql+psycopg://runtime_local:local-only@localhost:55432/agent_runtime
AGENT_PLATFORM_MIGRATION_DATABASE_URL=postgresql+psycopg://runtime_admin:local-admin-only@localhost:55432/agent_runtime
AGENT_PLATFORM_WORKER_POLL_INTERVAL_SECONDS=0.25
AGENT_PLATFORM_OPERATION_TIMEOUT_SECONDS=30
# Opt-in local demo identity. Bind the API to 127.0.0.1 when enabled.
AGENT_PLATFORM_DEVELOPMENT_MODE=true
AGENT_PLATFORM_DEVELOPMENT_TOKEN=local-demo-token-do-not-deploy
